/* Tiny MQTT 3.1.1 WebSocket client for this project. No CDN or third-party runtime.
 * Supports CONNECT/CONNACK, SUBSCRIBE (auto re-subscribe after reconnect), PUBLISH QoS 0,
 * keep-alive PINGREQ, multi-packet frames and automatic reconnect.
 * Intended for trusted LAN/demo use; use wss:// and broker auth in production.
 */
(function (g) {
  'use strict';
  const enc = new TextEncoder(), dec = new TextDecoder();
  const str = s => { const b = enc.encode(s); return [b.length >> 8, b.length & 255, ...b]; };
  function rem(n) { const a = []; do { let d = n % 128; n = Math.floor(n / 128); if (n > 0) d |= 128; a.push(d); } while (n > 0); return a; }

  class Client {
    constructor(url, opts = {}) {
      this.url = url; this.opts = opts; this.handlers = {}; this.connected = false;
      this.subs = []; this.pid = 0; this.buf = new Uint8Array(0); this.closed = false;
      this.id = 'mirror-' + Math.random().toString(16).slice(2, 10);
      this.keepalive = Math.max(5, Math.min(600, Number(opts.keepalive) || 30));
      this.connect();
    }
    on(n, fn) { (this.handlers[n] || (this.handlers[n] = [])).push(fn); return this; }
    emit(n, ...a) { (this.handlers[n] || []).forEach(f => { try { f(...a); } catch (e) { console.error(e); } }); }
    send(bytes) { if (this.ws && this.ws.readyState === 1) { this.ws.send(new Uint8Array(bytes)); return true; } return false; }
    packet(h, b) { return this.send([h, ...rem(b.length), ...b]); }

    connect() {
      clearTimeout(this.retry); clearInterval(this.ping);
      this.buf = new Uint8Array(0);
      let ws;
      try { ws = this.ws = new WebSocket(this.url, 'mqtt'); }
      catch (e) { this.emit('error', e); this.schedule(); return; }
      ws.binaryType = 'arraybuffer';
      ws.onopen = () => {
        const u = this.opts.username ? str(this.opts.username) : [];
        const p = (this.opts.username && this.opts.password) ? str(this.opts.password) : [];
        const flags = 2 | (u.length ? 128 : 0) | (p.length ? 64 : 0);
        this.packet(0x10, [...str('MQTT'), 4, flags, this.keepalive >> 8, this.keepalive & 255, ...str(this.id), ...u, ...p]);
      };
      ws.onmessage = e => this.receive(new Uint8Array(e.data));
      ws.onerror = () => this.emit('error', new Error('WebSocket/MQTT connection failed'));
      ws.onclose = () => {
        if (ws !== this.ws) return;               // stale socket
        clearInterval(this.ping);
        const was = this.connected; this.connected = false;
        if (was) this.emit('offline');
        if (!this.closed) this.schedule();
      };
    }
    schedule() {
      clearTimeout(this.retry);
      this.retry = setTimeout(() => { this.emit('reconnect'); this.connect(); }, this.opts.reconnectPeriod || 2000);
    }
    receive(chunk) {
      const m = new Uint8Array(this.buf.length + chunk.length); m.set(this.buf); m.set(chunk, this.buf.length); this.buf = m;
      for (;;) {                                  // one WS frame may hold several packets (or half of one)
        const a = this.buf; if (a.length < 2) return;
        let i = 1, mul = 1, n = 0, d;
        do { if (i >= a.length) return; d = a[i++]; n += (d & 127) * mul; mul *= 128; } while (d & 128 && mul < 268435456);
        if (a.length < i + n) return;
        this.handle(a[0], a.subarray(i, i + n));
        this.buf = a.slice(i + n);
      }
    }
    handle(h, b) {
      const type = h >> 4;
      if (type === 2) {                           // CONNACK
        if (b.length >= 2 && b[1] === 0) {
          this.connected = true;
          this.ping = setInterval(() => this.send([0xC0, 0]), this.keepalive * 500);
          this.emit('connect');
          this.subs.forEach(s => this.sendSub(s.topic));
        } else this.emit('error', new Error('MQTT CONNACK rejected (code ' + (b[1] ?? '?') + ')'));
      } else if (type === 3) {                    // PUBLISH
        if (b.length < 2) return;
        const len = (b[0] << 8) | b[1]; let i = 2;
        if (i + len > b.length) return;
        const topic = dec.decode(b.subarray(i, i + len)); i += len;
        const qos = (h >> 1) & 3;
        if (qos === 3) { this.emit('error', new Error('Malformed MQTT PUBLISH QoS')); return; }
        if (qos === 2) { this.emit('error', new Error('MQTT QoS 2 is not supported by this lightweight client')); return; }
        let packetId = 0;
        if (qos === 1) {
          if (i + 2 > b.length) { this.emit('error', new Error('Malformed MQTT PUBLISH packet identifier')); return; }
          packetId = (b[i] << 8) | b[i + 1]; i += 2;
          if (!packetId) { this.emit('error', new Error('Invalid MQTT packet identifier')); return; }
        }
        const payload = dec.decode(b.subarray(i));
        this.emit('message', topic, { toString: () => payload });
        // QoS 1 messages (including retained online/status and presence) must be acknowledged.
        if (qos === 1) this.packet(0x40, [packetId >> 8, packetId & 255]);
      }                                           // SUBACK / PINGRESP ignored
    }
    sendSub(topic) { const id = (++this.pid % 65535) + 1; this.packet(0x82, [id >> 8, id & 255, ...str(topic), 0]); }
    subscribe(topic, cb) {
      if (!this.subs.some(s => s.topic === topic)) this.subs.push({ topic });
      if (this.connected) this.sendSub(topic);
      if (cb) cb(null);
    }
    publish(topic, payload, opts = {}) {
      if (!this.connected) return false;
      return this.packet(0x30 | (opts.retain ? 1 : 0), [...str(topic), ...enc.encode(String(payload))]);
    }
    end() { this.closed = true; clearTimeout(this.retry); clearInterval(this.ping); if (this.ws) this.ws.close(); }
  }
  g.mqtt = { connect: (url, opts) => new Client(url, opts) };
})(window);
